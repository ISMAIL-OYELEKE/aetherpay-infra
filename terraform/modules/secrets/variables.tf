variable "name" {
  description = "Name prefix, e.g. aetherpay-staging."
  type        = string
}

variable "signing_keys" {
  description = "Signing keys to manage, as name => description. Values are generated by the rotation Lambda, never by Terraform."
  type        = map(string)
  default = {
    "partner-webhook-hmac"     = "HMAC key that partners use to sign webhooks sent to AetherPay"
    "custodian-request-signer" = "HMAC key AetherPay uses to sign requests to vault custodians"
  }
}

variable "rotation_schedule" {
  description = "Secrets Manager rotation schedule expression."
  type        = string
  default     = "rate(30 days)"
}

variable "secrets_kms_key_arn" {
  description = "CMK used to envelope-encrypt the secrets."
  type        = string
}

variable "logs_kms_key_arn" {
  description = "CMK used to encrypt the rotation Lambda log group."
  type        = string
}

variable "vpc_id" {
  description = "VPC that hosts the rotation Lambda."
  type        = string
}

variable "app_subnet_ids" {
  description = "Private application subnets for the rotation Lambda."
  type        = list(string)
}

variable "endpoint_security_group_id" {
  description = "Security group of the interface endpoints (the Lambda may only talk to these)."
  type        = string
}

variable "secretsmanager_vpce_id" {
  description = "Secrets Manager interface endpoint ID. Secret reads/writes from anywhere else are denied."
  type        = string
}

variable "additional_vpce_ids" {
  description = "Secrets Manager endpoints in other regions (DR) that may also read the replicated secrets."
  type        = list(string)
  default     = []
}

variable "replica_regions" {
  description = "Replicate every signing secret to these regions, each encrypted with that region's CMK. Rotation happens once, in this region."
  type        = map(string) # region => CMK ARN in that region
  default     = {}
}

variable "reader_workloads" {
  description = "Values of the aetherpay:workload principal tag allowed to read secret values."
  type        = list(string)
  default     = ["ingestor"]
}

variable "permissions_boundary_arn" {
  description = "Permissions boundary for IAM roles created here."
  type        = string
  default     = null
}

variable "rotation_reserved_concurrency" {
  description = "Reserved concurrency for the rotation Lambda (-1 = none). New AWS accounts often have a total concurrency quota of 10, and AWS refuses any reservation that would leave fewer than 10 unreserved."
  type        = number
  default     = -1
}

variable "log_retention_days" {
  description = "Rotation Lambda log retention."
  type        = number
  default     = 365
}

variable "tags" {
  description = "Tags applied to every resource."
  type        = map(string)
  default     = {}
}
